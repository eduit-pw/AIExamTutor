   </item>
    <item>
     <widget class="QLabel" name="supportLabel">
      <property name="text"><string>&lt;b&gt;Wesprzyj projekt&lt;/b&gt;&lt;br/&gt;Jeśli aplikacja pomaga Ci w nauce, możesz wesprzeć jej rozwój.</string></property>
