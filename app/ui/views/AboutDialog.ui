<ui version="4.0">
 <class>AboutDialog</class>
 <widget class="QWidget" name="aboutRoot">
  <property name="windowTitle"><string>O aplikacji</string></property>
  <layout class="QVBoxLayout" name="verticalLayout">
   <item>
    <widget class="QLabel" name="titleLabel">
